# Frontend Environment Variables Example
# Copy these to your hosting provider's environment variables dashboard

# API Configuration
# Set this to your backend URL (include /api at the end)
# If not set, will use http://localhost:5001/api in dev, /api in production
VITE_API_URL=https://cloud-nest-pi.vercel.app/api

# Cloudinary Configuration (Optional - for direct client uploads)
# Usually not needed as backend handles uploads
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_API_KEY=your-api-key
# VITE_CLOUDINARY_UPLOAD_PRESET=your-preset

# WebSocket URL (Optional - if using websockets)
# VITE_WS_URL=wss://cloud-nest-pi.vercel.app

# Note: For local development, create a .env.local file with these values
# For production: Set these in your hosting provider's dashboard
#    - Netlify: Site settings → Environment variables
#    - Vercel: Project settings → Environment Variables

